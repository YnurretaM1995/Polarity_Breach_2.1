MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 02_Shooter
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 0}
  lines:
  - text: Movement on deck one. Same pattern as the boarding party
    speakerName: 
    leftPortrait: {fileID: 21300000, guid: 540d1e73e6893014498731ed6c396d62, type: 3}
    rightPortrait: {fileID: 21300000, guid: 325e68328d3038d46bf39046ca187284, type: 3}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: "They carry a polarity \u2014 black or white. So do their rounds. Match
      their color and their fire goes straight through me. Harmless."
    speakerName: 
    leftPortrait: {fileID: 21300000, guid: 540d1e73e6893014498731ed6c396d62, type: 3}
    rightPortrait: {fileID: 21300000, guid: 325e68328d3038d46bf39046ca187284, type: 3}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: But it cuts both ways. My shots pass through them too. To hurt them, I
      have to be the opposite of what they are.
    speakerName: 
    leftPortrait: {fileID: 21300000, guid: 540d1e73e6893014498731ed6c396d62, type: 3}
    rightPortrait: {fileID: 21300000, guid: 325e68328d3038d46bf39046ca187284, type: 3}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Switch to survive. Switch again to kill. Let's find out how fast I can
      do both.
    speakerName: 
    leftPortrait: {fileID: 21300000, guid: 540d1e73e6893014498731ed6c396d62, type: 3}
    rightPortrait: {fileID: 21300000, guid: 325e68328d3038d46bf39046ca187284, type: 3}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: "Keyboard: Right Click \nGamepad: Left Trigger (LT)"
    speakerName: 
    leftPortrait: {fileID: 21300000, guid: 540d1e73e6893014498731ed6c396d62, type: 3}
    rightPortrait: {fileID: 21300000, guid: 325e68328d3038d46bf39046ca187284, type: 3}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 1
    keyboardHint: 
    gamepadHint: 
