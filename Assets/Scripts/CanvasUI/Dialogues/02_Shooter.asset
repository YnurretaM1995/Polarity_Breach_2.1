  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 02_Shooter
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 21300000, guid: 919360665e9777246bd0b2b3b2454223, type: 3}
  leftPortrait: {fileID: 21300000, guid: c5a77ef38f5fd0c47ab83e999215f3b6, type: 3}
  rightPortrait: {fileID: 21300000, guid: 7829589a8608a79478615ba42ea94144, type: 3}
  lines:
  - text: Movement on deck one. Looks like more of the same things that boarded us.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: They're either black or white, and their attacks match their polarity.
      Match their color, and their shots can't hurt me.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: But the same applies to them. If I match their polarity, my shots do nothing.
      I need to switch to the opposite color to hurt them.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Switch to survive. Switch again to kill. I'll need to do both quickly.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: "Keyboard: Right Click \nGamepad: Left Trigger (LT)"
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 1
    keyboardHint: 
    gamepadHint: 
