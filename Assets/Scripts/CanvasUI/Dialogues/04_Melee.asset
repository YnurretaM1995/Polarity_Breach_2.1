  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 04_Melee
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 21300000, guid: 919360665e9777246bd0b2b3b2454223, type: 3}
  leftPortrait: {fileID: 21300000, guid: c5a77ef38f5fd0c47ab83e999215f3b6, type: 3}
  rightPortrait: {fileID: 21300000, guid: 0bd507187095d4748bc640dd1c09de48, type: 3}
  lines:
  - text: Different build. No weapon.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: 'These ones don''t shoot. They close the distance and tear. '
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: 'And the suit drags when they''re near. Something in their field.

      The
      closer they get, the slower I move.'
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Same rule still applies. Matching polarity, no damage. On either side.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Don't let them swarm me. Once I'm slow, I'm theirs.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
