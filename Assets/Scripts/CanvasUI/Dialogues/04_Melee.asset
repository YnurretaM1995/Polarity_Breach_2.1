  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 04_Melee
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 21300000, guid: 919360665e9777246bd0b2b3b2454223, type: 3}
  leftPortrait: {fileID: 21300000, guid: c5a77ef38f5fd0c47ab83e999215f3b6, type: 3}
  rightPortrait: {fileID: 21300000, guid: bf5a57fee9e1d1149998209f4923d083, type: 3}
  lines:
  - text: These ones are different. No weapons.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: 'They don''t attack directly. They rush me and interfere with the suit. '
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: The closer they get, the slower I move.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: 'Switching polarity knocks them back and stuns them for a few seconds. '
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Keep them away, switch when they get too close, and use the opening to
      finish them off.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
