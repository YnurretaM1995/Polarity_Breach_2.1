  m_Name: 08_Room3Cleared
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 0}
  lines:
  - text: Last deck. No more of them left standing.
    speakerName: 
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: The gate ahead isn't like the others. It's bigger. Older. Everything on
      this ship has been walking out of it.
    speakerName: 
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: hatever's on the other side is the one they answer to. Kill it, and the
      rest stop coming.
    speakerName: 
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Nine hours to Earth. This is where it ends.
    speakerName: 
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    clearLeftPortrait: 0
    clearRightPortrait: 0
    isPrompt: 0
