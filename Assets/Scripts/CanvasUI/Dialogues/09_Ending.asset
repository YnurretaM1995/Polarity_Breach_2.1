  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 09_Ending
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 21300000, guid: e9f59be3ac1af3444b00d1a1e48fcace, type: 3}
  leftPortrait: {fileID: 21300000, guid: c5a77ef38f5fd0c47ab83e999215f3b6, type: 3}
  rightPortrait: {fileID: 0}
  lines:
  - text: It's not moving anymore. I waited to make sure. It's dead.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: All the gates shut down at the same time. Whatever was keeping them open
      is gone.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: The Meridian is badly damaged. Several sections are open to space, but
      she should still make it to Earth.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Earth is still down there. Safe. Completely unaware of what almost happened.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Good. Let's keep it that way.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
