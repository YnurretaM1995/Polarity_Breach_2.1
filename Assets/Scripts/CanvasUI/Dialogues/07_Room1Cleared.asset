  lines:
  - text: Deck's quiet. That's all of them.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 1
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: "Something opened at the far end \u2014 one of their gates. They came in
