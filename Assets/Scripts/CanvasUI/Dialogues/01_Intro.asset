MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9dd4f8086f956f4abe7f031ca0fae0e, type: 3}
  m_Name: 01_Intro
  m_EditorClassIdentifier: Assembly-CSharp::PolarityBreach.UI.DialogueSequence
  fullScreenBackground: {fileID: 21300000, guid: e9f59be3ac1af3444b00d1a1e48fcace, type: 3}
  leftPortrait: {fileID: 21300000, guid: c5a77ef38f5fd0c47ab83e999215f3b6, type: 3}
  rightPortrait: {fileID: 0}
  lines:
  - text: Forty-one days out from Earth. Routine cargo run. Nothing unusual on the
      scopes.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 1
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Then they breached the hull and came aboard.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: 'Their weapons use two polarities: black and white. Match the polarity
      of an attack, and it passes right through.'
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: I watched Vasquez take a white shot to the chest without a scratch. The
      next one was black. She didn't survive.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: The Meridian is locked on course for Earth. Nineteen hours until we get
      there. If they're still aboard when we arrive, Earth is in danger.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: So I clear the ship. Room by room.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
  - text: Then I find whatever is controlling them.
    speakerName: 
    leftPortrait: 0
    rightPortrait: 0
    isPrompt: 0
    keyboardHint: 
    gamepadHint: 
